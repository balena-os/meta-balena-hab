From: Alex Gonzalez <alexg@balena.io>
Date: Wed, 6 Nov 2024 15:49:50 +0100
Subject: [PATCH] u-boot-compulab: iot-gate-imx8plus: configure for secure boot

Signed-off-by: Alex Gonzalez <alexg@balena.io>
---
 board/compulab/plat/Kconfig | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/board/compulab/plat/Kconfig b/board/compulab/plat/Kconfig
--- a/board/compulab/plat/Kconfig
+++ b/board/compulab/plat/Kconfig
@@ -56,2 +56,5 @@
 	bool "CompuLab iot-gate-imx8plus"
+	select FSL_CAAM
+	select FSL_BLOB
+	select MISC
 	select IMX8MP
